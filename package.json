{
  "name": "grid-plan",
  "version": "4.0.0",
  "private": false,
  "type": "module",
  "description": "A Vue3 dynamic 2d grid component ideal to view and arrange elements on a room, datacenter or rack blueprint.",
  "keywords": [
    "grid",
    "vue",
    "2d grid",
    "3d",
    "plan",
    "blueprint",
    "room",
    "datacenter",
    "rack",
    "component"
  ],
  "author": "Alec Lloyd Probert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphieros/grid-plan.git"
  },
  "homepage": "https://grid-plan.graphieros.com/",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/grid-plan.js",
      "default": "./dist/grid-plan.js"
    }
  },
  "module": "./dist/grid-plan.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node cleanup.cjs",
    "dev": "pnpm --dir playground run dev",
    "build": "pnpm run clean && vite build --mode production && pnpm run build:types",
    "preview": "pnpm --dir playground run preview",
    "test": "vitest",
    "test:e2e": "pnpm --dir playground run test:e2e",
    "test:e2e:dev": "pnpm --dir playground run test:e2e:dev",
    "build:playground": "pnpm --dir playground run build",
    "test:playground": "pnpm --dir playground run test",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:playground": "pnpm --dir playground run typecheck",
    "build:types:watch": "vue-tsc -p tsconfig.build.json --watch",
    "test:types": "pnpm run build && node scripts/typecheck-package.mjs"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "three": "^0.187.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "3.3.14",
    "vue-types-min": "npm:@vue/runtime-dom@3.3.0"
  },
  "peerDependencies": {
    "three": "^0.187.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
